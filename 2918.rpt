IIF([ТИП КЛИЕНТА] ='ИП', 2,
IIF([ТИП КЛИЕНТА] ='Физ. лицо', 4,
IIF([ТИП КЛИЕНТА] ='Иностранное лицо', 3, 0)
)))
 */


