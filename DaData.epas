{@action
ID=0145BC0A-F521-4FBA-9933-2653831D580A
OrigName=GetOrganizationInfoAction
Name=Получить информацию об организации
Group=API Dadata
UI=<ui>
    <expr name="_expr_inn" caption="ИНН организации"/>
    <expr name="_expr_api_key" caption="API ключ"/>
</ui>
Description=Отправляет запрос к API Dadata и получает информацию об организации по ИНН.
@}

procedure GetOrganizationInfoAction(const ExprINN: string; const ExprApiKey: string);
var
  INN: string;
  ApiKey: string;
begin
  INN := VarToStr(EvalExpr(ExprINN, Self));
  ApiKey := VarToStr(EvalExpr(ExprApiKey, Self));

  if (INN = '') or (ApiKey = '') then Exit;

  DA_FIRMGET(ApiKey, INN);
end;

