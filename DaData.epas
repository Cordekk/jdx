{@module
Author=Cordek
Version=2.0
Description=Модуль для работы с API Dadata.
@}


function GetVar(s:string):variant;
begin
result:=EvalExpr('iif(varexists('''+s+''')=1,getvar('''+s+'''),block ( setvar('''+s+''',null), getvar('''+s+''') ))',Self);
end;

function ReplaceSpecialChars(const Value: string): string;
var
  i: Integer;
  ResultValue: string;
begin
  ResultValue := '';
  for i := 1 to Length(Value) do
  begin
    case Value[i] of
      '"': ResultValue := ResultValue + '';
      '\': ResultValue := ResultValue + '';
      '/': ResultValue := ResultValue + '';
      #8: ResultValue := ResultValue + '';
      #9: ResultValue := ResultValue + '';
      #10: ResultValue := ResultValue + '';
      #12: ResultValue := ResultValue + '';
      #13: ResultValue := ResultValue + '';
    else
      ResultValue := ResultValue + Value[i];
    end;
  end;
  Result := ResultValue;
end;

function UnixToDateTime(const AValue: variant): TDateTime;
var
  R: variant;
  Dt: TDateTime;
begin
  if VarIsNull(AValue) or VarIsEmpty(AValue) then
    Result := 0
  else
  begin
    R := AddSecond(StrToDateTime('01.01.1970'), AValue);
    if TryStrToDateTime(FloatToStr(R), Dt) then
      Result := TDateTime(R)
    else
      Result := 0;
  end;
end;

function DateFromDateTime(const AValue: variant): string;
begin
  if VarIsNull(AValue) or VarIsEmpty(AValue) then
    Result := ''
  else
    Result := FormatDateTime('dd.mm.yyyy', UnixToDateTime(AValue));
end;

function DDT_Date(const Dt: string): string;
begin
  if Dt = '' then
    Result := ''
  else
    Result := DateFromDateTime(StrToInt64(Dt) div 1000);
end;

function CheckNReplace(p, s: string): string;
var
  r: string;
begin
  if s = '' then
    Exit;

  if (POS('ogrn_date',p)>0) or
     (POS('actuality_date',p)>0) or
      (POS('registration_date',p)>0) or
      (POS('liquidation_date',p)>0) then
  begin
    r := DDT_Date(s);
    Result := r;
  end
  else if p = 'data.state.status' then
  begin
    if s = 'ACTIVE' then
      r := 'Действующая'
    else if s = 'LIQUIDATING' then
      r := 'Ликвидируется'
    else if s = 'LIQUIDATED' then
      r := 'Ликвидирована';
    Result := r;
  end
  else if p = 'data.type' then
  begin
    if s = 'LEGAL' then
      r := 'Юридическое лицо'
    else if s = 'INDIVIDUAL' then
      r := 'Индивидуальный предприниматель';
    Result := r;
  end
  else if p = 'data.branch_type' then
  begin
    if s = 'MAIN' then
      r := 'Головная организация'
    else if s = 'BRANCH' then
      r := 'Филиал';
    Result := r;
  end
  else if p = 'data.opf.type' then
  begin
    if s = 'BANK' then
      r := 'Банк'
    else if s = 'BANK_BRANCH' then
      r := 'Филиал банка'
    else if s = 'NKO' then
      r := 'Небанковская кредитная организация (НКО)'
    else if s = 'NKO_BRANCH' then
      r := 'Филиал НКО'
    else if s = 'RKC' then
      r := 'Расчетно-кассовый центр'
    else if s = 'OTHER' then
      r := 'Другой';
    Result := r;
  end
  else
    Result := s;
end;

function ProcessJsonElement(const Element: TJSONData; const Prefix: string): string;
var
  JsonObject: TJSONObject;
  JsonArray: TJSONArray;
  I, Index: Integer;
  Key: String;
  NewPrefix: string;
  Value: string;
  CurrentResult: string;
  ResultString: string;
begin
  Result := ''; // Инициализируем результат пустой строкой

  if Element is TJSONObject then
  begin
    JsonObject := TJSONObject(Element);
    for Index := 0 to JsonObject.Count - 1 do
    begin
      Key := JsonObject.Names[Index];
      if Prefix = '' then
        NewPrefix := Key
      else
        NewPrefix := Prefix + '.' + Key;
      CurrentResult := ProcessJsonElement(JsonObject.Items[Index], NewPrefix);
      if (CurrentResult <> '') and (Result <> '') then
        Result := Result + ';' + CurrentResult
      else
        Result := Result + CurrentResult;
    end;
  end
  else if Element is TJSONArray then
  begin
    JsonArray := TJSONArray(Element);
    for I := 0 to JsonArray.Count - 1 do
    begin
      if Prefix = 'suggestions' then
        begin
        NewPrefix := IIF(I=0,'',IntToStr(I))
        EvalExpr('setvar("Count_suggestions", ' + IntToStr(I) + ')', Self);
        end
        else NewPrefix := Format('%s_%d', [Prefix, I]);
      CurrentResult := ProcessJsonElement(JsonArray.Items[I], NewPrefix);
      if (CurrentResult <> '') and (Result <> '') then
        Result := Result + ';' + CurrentResult
      else
        Result := Result + CurrentResult;
    end;
  end
  else if Element.JSONType = jtString then
  begin
    Value := Element.AsString;
    if Value <> '' then
    begin
      Value := ReplaceSpecialChars(Value); // Заменяем специальные символы на пробелы
      Value := CheckNReplace(Prefix, Value); // Проверяем и заменяем значения по необходимости
      EvalExpr('setvar("' + Prefix + '", "' + Value + '")', Self);
      Result := Result + Format('%s=%s', [Prefix, Value]);
    end;
  end
  else if Element.JSONType = jtNumber then
  begin
    Value := Element.AsString;
    if Value <> '' then
    begin
      Value := CheckNReplace(Prefix, Value); // Проверяем и заменяем значения по необходимости
      EvalExpr('setvar("' + Prefix + '", "' + Value + '")', Self);
      Result := Result + Format('%s=%s', [Prefix, Value]);
    end;
  end
  else if Element.JSONType = jtBoolean then
  begin
    if Element.AsBoolean then
      Value := 'True'
    else
      Value := 'False';
    EvalExpr('setvar("' + Prefix + '", "' + Value + '")', Self);
    Result := Result + Format('%s=%s', [Prefix, Value]);
  end
  else if Element.JSONType = jtNull then
  begin
    EvalExpr('setvar("' + Prefix + '", "null")', Self);
    Result := Result + Format('%s=null', [Prefix]);
  end;
end;


{@function
OrigName=PostAndGetJsonResponse
Name=PostAndGetJsonResponse
Args=vvv
Result=s
Group=API DaData
Description=Универсальная функция для отправки POST-запроса и получения JSON-ответа.<br>
<center><code>PostAndGetJsonResponse(API-ключ, строка поиска, URL)</code></center><br>
<b>Параметры:</b> API-ключ - текст, строка поиска - текст, URL - текст.<br><br>
<b>Результат:</b> текст.
@}
function PostAndGetJsonResponse(const ApiKey: string; const SearchQuery: string; const AURL: string): string;
var
  HttpClient: THTTPClient;
  JsonResponse: string;
  JsonObject: TJSONObject;
  SuggestionsArray: TJSONArray;
  FirstSuggestion: TJSONObject;
  Data: TJSONObject;
  BodyStream: TStringStream;
  ParsedJson: TJSONData;
  SuggestionsIndex: Integer;
begin
  Result := '';
  HttpClient := THTTPClient.Create; // Создаем объект THTTPClient без параметров
  try
    // Устанавливаем заголовок Content-Type
    HttpClient.AddHeader('Content-Type', 'application/json');

    // Устанавливаем заголовок Authorization
    HttpClient.AddHeader('Authorization', 'Token ' + ApiKey);

    // Формируем тело запроса
    BodyStream := TStringStream.Create(SearchQuery);
    try
      // Устанавливаем тело запроса
      HttpClient.RequestBody := BodyStream;

      // Отправляем POST-запрос на сервер и получаем ответ
      HttpClient.Send('POST', AURL);
      JsonResponse := HttpClient.Content;
       // debug(  JsonResponse)
      if Pos('200', IntToStr(HttpClient.ResponseStatusCode)) > 0 then
      begin
        // Парсим JSON данные из строки
        ParsedJson := ReadJSONFromString(JsonResponse);
        try
          if ParsedJson is TJSONObject then
          begin
            JsonObject := TJSONObject(ParsedJson);
            Result := ProcessJsonElement(JsonObject, '');
              if Result <> '' then
              Result := Copy(Result, 1, Length(Result) - 1); // Убираем последний ';'
          end
          else
          begin
            Result := 'Ошибка парсинга JSON';
          end;
        finally
          ParsedJson.Free;
        end;
      end
      else
      begin
        Result := 'Ошибка при выполнении запроса: ' + IntToStr(HttpClient.ResponseStatusCode);
      end;
    finally
      BodyStream.Free;
    end;
  finally
    HttpClient.Free;
  end;
end;


{@function
OrigName=DA_ORGGET
Name=DA_ORGGET
Args=vv
Result=s
Group=API DaData
Description=Функция обращается к сервису Dadata.ru<br><br>
Ищет компании и индивидуальных предпринимателей: <br><br>
по ИНН, названию (полному и краткому);     <br><br>
ФИО (для индивидуальных предпринимателей);<br><br>
ФИО руководителя компании;  <br><br>
<center><code>DA_ORGGET(API-ключ, строка поиска)</code></center><br>
<b>Параметры:</b> API-ключ - текст, строка поиска - текст.<br><br>
<b>Результат:</b> текст.<br><br>
API-ключ необходим для доступа к сервису DaData.ru. Ключ можно узнать в
личном кабинете.<br>
Строка поиска - название, краткое название, часть названия или ИНН организации.<br>
Результат функции - множество полей-реквизитов. Функция
извлекает реквизиты и сохраняет в специальной переменной. Для доступа к
реквизитам используется GETVAR('путь к рекизиту') или CASEOF('путь к рекизиту',Result).
Для второй, третьей и далее организации в списке надо использовать GETVAR('i_путь к рекизиту') или CASEOF('i_путь к рекизиту',Result), где i это номер в списке (1, 2 и т.п.). getvar("Count_suggestions") покажет, сколько организаций найдено

 Повторный вызов функции DA_ORGGET заменит содержимое специальной переменной новыми реквизитами.
@}

function DA_ORGGET(const ApiKey: string; const Query: string): string;
begin
  Result := PostAndGetJsonResponse(ApiKey, Format('{"query": "%s"}', [Query]), 'https://suggestions.dadata.ru/suggestions/api/4_1/rs/suggest/party');
end;


