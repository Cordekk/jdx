{@module
Author=Cordek
Version=1.1
Description=Переход по ссылке для веб версии. Добавлен переход на новую вкладку.
@}


  {@action
Id=B408C9BC-DFF7-4DE2-9661-149CDA1E4C90
  @}
procedure GotoUrlButton(const ExprRun: String);
 var
S:string;
begin
S:=VarToStr(Session.EvalExpr(ExprRun,Self));
if (S = '')  then  Exit;
   Self.GotoUrl(S, gtoNewTab);
end;

