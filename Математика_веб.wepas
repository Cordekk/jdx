{@function
Name=LOG
@}
function LOG(base, x: Extended): Extended;
var qSQL: TdxSQLQuery;
begin
  qSQL := Session.sqlSelect('SELECT LOG(' + FloatToStr(base) + ', ' + FloatToStr(x) + ') FROM RDB$DATABASE');
  Result := qSQL.AsF['LOG'];
  qSQL.Free;
end;

