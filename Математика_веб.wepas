{@module
Author=Cordek
Version=1.0
Description=Математические функции:
 вычисления натурального логарифма - Ln, Cos, Sin и т.д. 
 а также извлечение числа из строки с лишними знаками (пробелы, тире и т.д) 
 Часть функций использует возможности сервера базы данных Firebird, и не будет работать при подключении к базе данных напрямую через SQLlite
 Веб-версия
@}


{@function
Name=Ln
@}
function Ln(x: Extended): Extended;
var qSQL: TdxSQLQuery;
begin
  qSQL := Session.sqlSelect('SELECT LN(' + FloatToStr(x) + ') FROM RDB$DATABASE'); // <button class="citation-flag" data-index="7"><button class="citation-flag" data-index="9">
  Result := qSQL.AsF['LN'];
  qSQL.Free;
end;


