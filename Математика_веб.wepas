Name=Exp
@}
function Exp(x: Extended): Extended;
var qSQL: TdxSQLQuery;
begin
  qSQL := Session.sqlSelect('SELECT EXP(' + FloatToStr(x) + ') FROM RDB$DATABASE'); // <button class="citation-flag" data-index="7"><button class="citation-flag" data-index="9">
