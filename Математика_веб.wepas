{@function
Name=Cosr
@}
function Cosr(a: Extended): Extended;
begin
  Result := Cos(a);
end;

{@function
Name=Sinr
@}
function Sinr(a: Extended): Extended;
begin
  Result := Sin(a);
end;

{@function
Name=Tgr
@}
function Tgr(a: Extended): Extended;
begin
  Result := Sin(a) / Cos(a);
end;

{@function
Name=Ctr
@}
function Ctr(a: Extended): Extended;
begin
  Result := Cos(a) / Sin(a);
end;

{@function
Name=Cosd
@}
function Cosd(a: Extended): Extended;
begin
  Result := Cos(a * Pi / 180);
end;

{@function
Name=Sind
@}
function Sind(a: Extended): Extended;
begin
  Result := Sin(a * Pi / 180);
end;

{@function
Name=Tgd
@}
function Tgd(a: Extended): Extended;
begin
  Result := Sind(a) / Cosd(a);
end;

{@function
Name=Ctd
@}
function Ctd(a: Extended): Extended;
begin
  Result := Cosd(a) / Sind(a);
end;

{@function
Name=Pif
@}
function Pif: Extended;
begin
  Result := Pi;
end;


