{@function
OrigName=LOG
Name=LOG
Args=nn
Result=n
Group=Математика
Description=Возвращает логарифм числа x по основанию base.<br>
<center><code>LOG([base], [x])</code></center><br>
<b>Параметры:</b> base > 0, base ≠ 1; x > 0 <button class="citation-flag" data-index="2"><button class="citation-flag" data-index="3"><button class="citation-flag" data-index="7">.<br><br>
<b>Результат:</b> вещественное число.<br><br>
<font color="#FF0000"><b>Примечание:</b> Оба аргумента должны быть положительными, основание не равно 1.</font>
@}
function LOG(base, x: Extended): Extended;
var qSQL: TdxSQLQuery;
begin
  qSQL := sqlSelect('SELECT LOG(' + FloatToStr(base) + ', ' + FloatToStr(x) + ') FROM RDB$DATABASE');
  Result := qSQL.AsF['LOG'];
  qSQL.Free;
end;

