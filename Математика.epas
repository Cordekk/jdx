  qSQL.Free;
end;





{@function
OrigName=Cosr
Name=Cosr
Args=n
Result=n
Group=Математика
Description=Функция вычисляет косинус числа a (в радианах).
Пример: Cosr([a])
@}
function Cosr(a: Extended): Extended;
begin
  Result := Cos(a);
end;

{@function
OrigName=Sinr
Name=Sinr
Args=n
Result=n
Group=Математика
Description=Функция вычисляет синус числа a (в радианах).
Пример: Sinr([a])
@}
function Sinr(a: Extended): Extended;
begin
  Result := Sin(a);
end;

{@function
OrigName=Tgr
Name=Tgr
Args=n
Result=n
Group=Математика
Description=Функция вычисляет тангенс числа a (в радианах). Tgr(a) = Sin(a)/Cos(a)
Пример: Tgr([a])
@}
function Tgr(a: Extended): Extended;
begin
  Result := Sin(a) / Cos(a);
end;

{@function
OrigName=Ctr
Name=Ctr
Args=n
Result=n
Group=Математика
Description=Функция вычисляет котангенс числа a (в радианах). Ctr(a) = Cos(a)/Sin(a)
Пример: Ctr([a])
@}
function Ctr(a: Extended): Extended;
begin
  Result := Cos(a) / Sin(a);
end;

{@function
OrigName=Cosd
Name=Cosd
Args=n
Result=n
Group=Математика
Description=Функция вычисляет косинус угла a (в градусах). 1 градус = π/180 радиан.
Пример: Cosd([a])
@}
function Cosd(a: Extended): Extended;
begin
  Result := Cos(a * Pi / 180);
end;

{@function
OrigName=Sind
Name=Sind
Args=n
Result=n
Group=Математика
Description=Функция вычисляет синус угла a (в градусах). 1 градус = π/180 радиан.
Пример: Sind([a])
@}
function Sind(a: Extended): Extended;
begin
  Result := Sin(a * Pi / 180);
end;

{@function
OrigName=Tgd
Name=Tgd
Args=n
Result=n
Group=Математика
Description=Функция вычисляет тангенс угла a (в градусах). Tgd(a) = Sind(a)/Cosd(a)
Пример: Tgd([a])
@}
function Tgd(a: Extended): Extended;
begin
  Result := Sind(a) / Cosd(a);
end;

{@function
OrigName=Ctd
Name=Ctd
Args=n
Result=n
Group=Математика
Description=Функция вычисляет котангенс угла a (в градусах). Ctd(a) = Cosd(a)/Sind(a)
Пример: Ctd([a])
@}
function Ctd(a: Extended): Extended;
begin
  Result := Cosd(a) / Sind(a);
end;

