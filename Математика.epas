{@function
OrigName=Asin
Name=Asin
Args=n
Result=n
Group=Математика
Description=Возвращает арксинус числа x (в радианах).<br>
<center><code>Asin([x])</code></center><br>
<b>Параметры:</b> x ∈ [-1, 1] <button class="citation-flag" data-index="5"><button class="citation-flag" data-index="9">.<br><br>
<b>Результат:</b> угол в радианах.<br><br>
<font color="#FF0000"><b>Примечание:</b> x должен быть в диапазоне от -1 до 1.</font>
@}
function Asin(x: Extended): Extended;
var qSQL: TdxSQLQuery;
begin
  qSQL := sqlSelect('SELECT ASIN(' + FloatToStr(x) + ') FROM RDB$DATABASE'); // <button class="citation-flag" data-index="7"><button class="citation-flag" data-index="9">
  Result := qSQL.AsF['ASIN'];
  qSQL.Free;
end;


