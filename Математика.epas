{@module
Author=Cordek
Version=1.0
Description=Математические функции:
 вычисления натурального логарифма - Ln, Cos, Sin и т.д.
 а также извлечение числа из строки с лишними знаками (пробелы, тире и т.д)
 Часть функций использует возможности сервера базы данных Firebird, и не будет работать при подключении к базе данных напрямую через SQLlite
@}



{@function
OrigName=Ln
Name=Ln
Args=n
Result=n
Group=Математика
Description=Возвращает натуральный логарифм числа x.<br>
<center><code>Ln([x])</code></center><br>
<b>Параметры:</b> x > 0 <button class="citation-flag" data-index="2"><button class="citation-flag" data-index="7">.<br><br>
<b>Результат:</b> вещественное число.<br><br>
<font color="#FF0000"><b>Примечание:</b> x должен быть положительным.</font>
@}
function Ln(x: Extended): Extended;
var qSQL: TdxSQLQuery;
begin
  qSQL := sqlSelect('SELECT LN(' + FloatToStr(x) + ') FROM RDB$DATABASE'); // <button class="citation-flag" data-index="7"><button class="citation-flag" data-index="9">
  Result := qSQL.AsF['LN'];
  qSQL.Free;
end;


