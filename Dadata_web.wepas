{@action
ID=0145BC0A-F521-4FBA-9933-2653831D580A
@}

procedure GetOrganizationInfoAction(const ExprINN: string; const ExprApiKey: string);
var
  INN: string;
  ApiKey: string;
begin
  INN := VarToStr(Session.EvalExpr(ExprINN, Self));
  ApiKey := VarToStr(Session.EvalExpr(ExprApiKey, Self));

  if (INN = '') or (ApiKey = '') then Exit;

  DA_FIRMGET(ApiKey, INN);
end;

{@action
ID=EFC95C73-45C3-4EC7-ADEC-DE1CB4066BAB
@}

procedure GetBankInfoAction(const ExprSearchQuery: string; const ExprApiKey: string);
var
  SearchQuery: string;
  ApiKey: string;
begin
  SearchQuery := VarToStr(Session.EvalExpr(ExprSearchQuery, Self));
  ApiKey := VarToStr(Session.EvalExpr(ExprApiKey, Self));

  if (SearchQuery = '') or (ApiKey = '') then Exit;

  DA_BANK_GET(ApiKey, SearchQuery);
end;

{@action
ID=6E07DEC9-AB14-431E-8B4D-1EFF04693549
@}

procedure GetAddressInfoAction(const ExprSearchQuery: string; const ExprApiKey: string);
var
  SearchQuery: string;
  ApiKey: string;
begin
