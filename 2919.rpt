IIF([Тип объекта текст]= 'Объекты окр. среды', 8,
 IIF([Тип объекта текст]='Продукция',1,
   IIF([Тип объекта текст]= 'Объекты производ. среды', 10,
     IIF([Тип объекта текст]= 'Био. материал' , 11, 1)
  )
  )
  )" id="2" tp="2" size="0"/><calcfield name="Не по адресу лаборатории" expression="IIF([Адрес временных работ (отбор2)]=''|[Адрес временных работ (отбор2)]=null, 'false','true')" id="4" tp="1" size="20"/><calcfield name="IsLab" expression="IIF([Отбор проб лаборатории]&gt;0,'true','false')" id="6" tp="1" size="5"/><calcfield name="UniqueAddressText" expression="NZ([Адрес временных работ (отбор2)],[Адрес отбора1])" id="8" tp="1" size="300"/><calcfield name="LabSelectionDate" expression="CSTR(NZ([Дата отбора2],[Дата отбора1]))" id="10" tp="1" size="50"/></calcfields><totals></totals><coloring></coloring><grid color="clWindow" alternatecolor="clWindow" selectedcolor="clHighlight" selectedtextcolor="clHighlightText" inactiveselectedcolor="clSilver" inactiveselectedtextcolor="clBlack" fixedcolor="clBtnFace" gridlinecolor="clSilver" gridlinestyle="psSolid" defaultrowheight="20" vertlines="1" horzlines="1" flat="0" wordwrap="0" rowselect="0" rowhighlight="0" cellellipsis="0" showhints="1" thumbtracking="1" colmove="0" allowchangesort="1" indicator="1" rowdelbn="0"><font name="Verdana" height="-13" color="clDefault" bold="0" italic="0" underline="0" strikeout="0"/><titlefont name="Verdana" height="-13" color="clDefault" bold="0" italic="0" underline="0" strikeout="0"/><columns><column color="clWindow" fixedcolor="clBtnFace" caption="Продукция" width="100" fieldname="f1" index="1" visible="1"><font name="Verdana" height="-13" color="clDefault" bold="0" italic="0" underline="0" strikeout="0"/><titlefont name="Verdana" height="-13" color="clDefault" bold="0" italic="0" underline="0" strikeout="0"/></column><column color="clWindow" fixedcolor="clBtnFace" caption="Тип объекта" width="100" fieldname="cf2" index="0" visible="1"><font name="Verdana" height="-13" color="clDefault" bold="0" italic="0" underline="0" strikeout="0"/><titlefont name="Verdana" height="-13" color="clDefault" bold="0" italic="0" underline="0" strikeout="0"/></column><column color="clWindow" fixedcolor="clBt